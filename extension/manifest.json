{
  "manifest_version": 3,
  "name": "Aoi",
  "version": "1.0.0",
  "description": "Shows your Aoi progress on manga sites and marks chapters as read, synced with the Aoi app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Aoi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://lmwsecuiylqkpeabckdv.supabase.co/*"],
  "content_scripts": [
    {
      "matches": ["https://aoi-mangas.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["config.js", "site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://aoi-mangas.vercel.app/*", "https://lmwsecuiylqkpeabckdv.supabase.co/*"],
      "js": ["config.js", "overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
